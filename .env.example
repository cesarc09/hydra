HYDRA_AUTH_TOKEN=change-me-to-a-random-string
HYDRA_DB_PATH=hydra.db

# Client-side: URL of the Hydra server. Leave unset on the host that runs
# hydra itself (localhost is the default). On remote client machines, set
# this to the public URL, e.g. https://hydra.example.com.
# HYDRA_URL=https://hydra.example.com
